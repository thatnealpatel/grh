/-!
# Fixed vertical gap-line price

Source: `e6b43a82d74c:.godel/alice/denominator-pair-gap-regions.md:19–35`,
especially line 29, used again in the adaptive bins at
`1d036a89b046:.godel/alice/denominator-pair-gap-regions.md:37–49`.
Source pin: `e97a8a47fbd771a5d2d069a46a8792a4b0c0f902`.
Owning check session: `01a20e90-1953-703f-a5c5-0300053aba36`.

Scope: the original triples `(m,(x,y))` at one denominator pair and on one
rational line through zero in the gaps. The actual list has at most one triple
per input `m`, so projection to these tuples loses no multiplicity. Masks,
smoothness, and second-row tests can only reduce the count. The theorem does
not sum over denominator pairs or bound the second-row residual.
-/

namespace VerticalGapLinePrice

open DenominatorPairMaskIndex (congruences_soluble_iff gapMask mem_gapMask
  maskedLattice mem_maskedLattice maskedLattice_mem_fiber_iff)

/-- The first-row conditions on a triple at a fixed pair and a fixed gap line.
The line is specified by its primitive integral direction `(i,j)`. Neither
individual gap is required to be nonzero for the estimate. -/
public structure Row (d e : ℕ) (F₁ q i j : ℤ) (V H : ℝ)
    (p : ℤ × ℤ × ℤ) : Prop where
  first_congruence : (d : ℤ) ∣ F₁ * p.1 - q * p.2.1
  second_congruence : (e : ℤ) ∣ F₁ * p.1 - q * p.2.2
  gap_coprime : Int.gcd p.2.1 (d : ℤ) = 1
  input_coprime : Int.gcd p.1 p.2.1 = 1
  input_pos : 0 < p.1
  input_le : (p.1 : ℝ) ≤ V
  first_gap_le : |(p.2.1 : ℝ)| ≤ H
  second_gap_le : |(p.2.2 : ℝ)| ≤ H
  gaps_ne : p.2.1 ≠ p.2.2
  on_line : p.2.1 * j = p.2.2 * i

/-- The integer line coordinate obtained by applying Bézout coefficients of `(i,j)`. -/
public def gapCoordinate (i j x y : ℤ) : ℤ :=
  Int.gcdA i j * x + Int.gcdB i j * y

private theorem direction_bezout {i j : ℤ} (hdir : Int.gcd i j = 1) :
    i * Int.gcdA i j + j * Int.gcdB i j = 1 := by
  simpa only [hdir, Nat.cast_one] using (Int.gcd_eq_gcd_ab i j).symm

/-- On the rational line, the signed coordinate recovers both original gaps. -/
public theorem gapCoordinate_iff {i j x y : ℤ} (hdir : Int.gcd i j = 1) :
    x * j = y * i ↔ (x,y) = (gapCoordinate i j x y * i, gapCoordinate i j x y * j) := by
  have hBez := direction_bezout hdir
  constructor
  · intro h
    apply Prod.ext <;> dsimp [gapCoordinate]
    · linear_combination -x * hBez + Int.gcdB i j * h
    · linear_combination -y * hBez - Int.gcdA i j * h
  · intro h
    obtain ⟨hx, hy⟩ := Prod.ext_iff.mp h
    change x = gapCoordinate i j x y * i at hx
    change y = gapCoordinate i j x y * j at hy
    linear_combination j * hx - i * hy

/-- In the other direction, scaling the primitive vector gives exactly the stated coordinate. -/
public theorem gapCoordinate_mul {i j : ℤ} (hdir : Int.gcd i j = 1) (k : ℤ) :
    gapCoordinate i j (k * i) (k * j) = k := by
  dsimp [gapCoordinate]
  linear_combination k * direction_bezout hdir

private def residue (L : ℕ) (B : ℤ) : (ℤ × ℤ) →+ ZMod L where
  toFun p := ((p.1 - B * p.2 : ℤ) : ZMod L)
  map_zero' := by simp
  map_add' p r := by
    simp only [Prod.fst_add, Prod.snd_add, Int.cast_sub, Int.cast_mul, Int.cast_add]
    ring

/-- The common homogeneous CRT fiber in the reduced coordinates `(m,k)`. -/
public def crtFiber (L : ℕ) (B : ℤ) : AddSubgroup (ℤ × ℤ) := (residue L B).ker

public theorem mem_crtFiber {L : ℕ} {B m k : ℤ} :
    (m,k) ∈ crtFiber L B ↔ (L : ℤ) ∣ m - B * k :=
  ZMod.intCast_zmod_eq_zero_iff_dvd _ _

/-- The entire fiber subgroup has index `L`, not just a sublattice generated by seen rows. -/
public theorem crtFiber_index (L : ℕ) (B : ℤ) : (crtFiber L B).index = L := by
  have hs : Function.Surjective (residue L B) := by
    intro z
    obtain ⟨m, rfl⟩ := ZMod.intCast_surjective z
    exact ⟨(m,0), by simp [residue]⟩
  exact (Nat.card_congr (QuotientAddGroup.quotientKerEquivOfSurjective _ hs).toEquiv).trans
    (Nat.card_zmod L)

private theorem row_coordinates {d e : ℕ} {F₁ q i j : ℤ} {V H : ℝ} {p : ℤ × ℤ × ℤ}
    (hg : 0 < d.gcd e) (hc : Int.gcd (F₁ * q) ((d : ℤ) * (e : ℤ)) = 1)
    (hdir : Int.gcd i j = 1) (hp : Row d e F₁ q i j V H p) :
    let k := gapCoordinate i j p.2.1 p.2.2
    p.2 = (k * i,k * j) ∧ Int.gcd k (d.gcd e : ℤ) = 1 ∧ (d.gcd e : ℤ) ∣ i - j ∧
      Int.gcd p.1 k = 1 ∧ |(k : ℝ)| ≤ 2 * H / (d.gcd e : ℝ) := by
  let k := gapCoordinate i j p.2.1 p.2.2
  have hpair : p.2 = (k * i, k * j) := (gapCoordinate_iff hdir).mp hp.on_line
  have hx : p.2.1 = k * i := congrArg Prod.fst hpair
  have hy : p.2.2 = k * j := congrArg Prod.snd hpair
  have hkx : k ∣ p.2.1 := ⟨i, hx⟩
  have hGd : (d.gcd e : ℤ) ∣ (d : ℤ) := Int.ofNat_dvd.mpr (Nat.gcd_dvd_left d e)
  have hkg := ((Int.isCoprime_iff_gcd_eq_one.mpr hp.gap_coprime).of_isCoprime_of_dvd_left
    hkx).of_isCoprime_of_dvd_right hGd
  have hmk := (Int.isCoprime_iff_gcd_eq_one.mpr hp.input_coprime).of_isCoprime_of_dvd_right hkx
  have hxy : (d.gcd e : ℤ) ∣ p.2.1 - p.2.2 :=
    (congruences_soluble_iff hc).mp ⟨p.1, hp.first_congruence, hp.second_congruence⟩
  have hdiff : p.2.1 - p.2.2 = k * (i - j) := by rw [hx, hy, mul_sub]
  have hGij : (d.gcd e : ℤ) ∣ i - j :=
    hkg.symm.dvd_of_dvd_mul_left (hdiff ▸ hxy)
  have hij : i ≠ j := fun h ↦ hp.gaps_ne (hx.trans (h ▸ hy.symm))
  have hdirection : (d.gcd e : ℝ) ≤ |((i - j : ℤ) : ℝ)| := by
    exact_mod_cast Int.le_of_dvd (abs_pos.mpr (sub_ne_zero.mpr hij)) ((dvd_abs _ _).2 hGij)
  have hdiffR : (p.2.1 : ℝ) - (p.2.2 : ℝ) = (k : ℝ) * ((i - j : ℤ) : ℝ) := by
    exact_mod_cast hdiff
  have htriangle := abs_sub (p.2.1 : ℝ) (p.2.2 : ℝ)
  rw [hdiffR, abs_mul] at htriangle
  refine ⟨hpair, Int.isCoprime_iff_gcd_eq_one.mp hkg, hGij,
    Int.isCoprime_iff_gcd_eq_one.mp hmk, (le_div_iff₀ (Nat.cast_pos.mpr hg)).2 ?_⟩
  exact (mul_le_mul_of_nonneg_left hdirection (abs_nonneg _)).trans
    (htriangle.trans (by linarith only [hp.first_gap_le, hp.second_gap_le]))

/-- An occupied primitive gap line has one CRT coefficient `B` for all signed `k`.
The equivalence describes the entire unmasked fiber. Actual rows inject into it by keeping
`m` and extracting `k`; their coordinates are primitive and have the reduced width `2*H/G`. -/
public theorem fixedLineCRT {d e : ℕ} {F₁ q i j : ℤ} {V H : ℝ} {a : ℤ × ℤ × ℤ}
    (hd : 0 < d) (hc : Int.gcd (F₁ * q) ((d : ℤ) * (e : ℤ)) = 1)
    (hdir : Int.gcd i j = 1) (ha : Row d e F₁ q i j V H a) :
    (d.gcd e : ℤ) ∣ i - j ∧ ∃ B : ℤ,
      (crtFiber (d.lcm e) B).index = d * e / d.gcd e ∧
      (∀ m k : ℤ, ((d : ℤ) ∣ F₁ * m - q * (k * i)) ∧ ((e : ℤ) ∣ F₁ * m - q * (k * j)) ↔
        (m,k) ∈ crtFiber (d.lcm e) B) ∧
      ∀ p : ℤ × ℤ × ℤ, Row d e F₁ q i j V H p →
        let k := gapCoordinate i j p.2.1 p.2.2
        p.2 = (k * i,k * j) ∧ Int.gcd k (d.gcd e : ℤ) = 1 ∧ Int.gcd p.1 k = 1 ∧
          |(k : ℝ)| ≤ 2 * H / (d.gcd e : ℝ) ∧ (p.1,k) ∈ crtFiber (d.lcm e) B := by
  have hg := Nat.gcd_pos_of_pos_left e hd
  obtain ⟨_, _, hGij, _, _⟩ := row_coordinates hg hc hdir ha
  obtain ⟨B, hBd, hBe⟩ := (congruences_soluble_iff hc).mpr hGij
  have hcrt (m k : ℤ) :
      ((d : ℤ) ∣ F₁ * m - q * (k * i)) ∧ ((e : ℤ) ∣ F₁ * m - q * (k * j)) ↔
        (m,k) ∈ crtFiber (d.lcm e) B := by
    have hm₀ : (B * k, (k * i,k * j)) ∈ maskedLattice d e 1 1 1 F₁ q := by
      refine mem_maskedLattice.mpr ⟨mem_gapMask.mpr (by simp), ?_, ?_⟩
      · convert hBd.mul_right k using 1
        ring
      · convert hBe.mul_right k using 1
        ring
    simpa [mem_crtFiber, mem_maskedLattice, mem_gapMask] using
      (maskedLattice_mem_fiber_iff hc hm₀ (m := m))
  refine ⟨hGij, B, (crtFiber_index _ _).trans (Nat.lcm_eq_mul_div _ _), hcrt, ?_⟩
  intro p hp
  obtain ⟨hpair, hkg, _, hmk, hk⟩ := row_coordinates hg hc hdir hp
  refine ⟨hpair, hkg, hmk, hk, (hcrt _ _).mp ?_⟩
  have hx : p.2.1 = gapCoordinate i j p.2.1 p.2.2 * i := congrArg Prod.fst hpair
  have hy : p.2.2 = gapCoordinate i j p.2.1 p.2.2 * j := congrArg Prod.snd hpair
  rw [← hx, ← hy]
  exact ⟨hp.first_congruence, hp.second_congruence⟩

/-- Determinant count without an independence assumption. Anchor at a point of maximal first
coordinate. Each normalized determinant identifies at most one point: a collision makes the
first-coordinate difference a multiple of the anchor's first coordinate, too small to be
nonzero. The first coordinate is positive, so this also identifies the second coordinate. -/
private theorem primitive_fiber_card_le {L : ℕ} {B : ℤ} {V K : ℝ} {S : Finset (ℤ × ℤ)}
    (hL : 0 < L) (hV : 0 ≤ V) (hK : 0 ≤ K)
    (hS : ∀ p ∈ S, p ∈ crtFiber L B ∧ Int.gcd p.1 p.2 = 1 ∧
      0 < p.1 ∧ (p.1 : ℝ) ≤ V ∧ |(p.2 : ℝ)| ≤ K) :
    (S.card : ℝ) ≤ 1 + 4 * V * K / (L : ℝ) := by
  rcases S.eq_empty_or_nonempty with rfl | hne
  · simp only [Finset.card_empty, Nat.cast_zero]
    positivity
  obtain ⟨p, hp, hmax⟩ := S.exists_max_image Prod.fst hne
  obtain ⟨hpL, hpprim, hp0, hpV, hpK⟩ := hS p hp
  have hLR : 0 < (L : ℝ) := Nat.cast_pos.mpr hL
  have hpR : 0 < (p.1 : ℝ) := by exact_mod_cast hp0
  let det (a : ℤ × ℤ) : ℤ := p.1 * a.2 - a.1 * p.2
  let f (a : ℤ × ℤ) : ℤ := det a / (L : ℤ)
  have hdet {a} (ha : a ∈ S) : (L : ℤ) ∣ det a := by
    convert dvd_sub ((mem_crtFiber.mp hpL).mul_right a.2)
      ((mem_crtFiber.mp (hS a ha).1).mul_right p.2) using 1
    dsimp [det]
    ring
  have hcancel {a} (ha : a ∈ S) : f a * (L : ℤ) = det a := Int.ediv_mul_cancel (hdet ha)
  have hinj : Set.InjOn f (S : Set (ℤ × ℤ)) := by
    intro a ha b hb hab
    have heq : det a = det b := (hcancel ha).symm.trans ((congrArg (· * (L : ℤ)) hab).trans
      (hcancel hb))
    have hcross : p.2 * (a.1 - b.1) = p.1 * (a.2 - b.2) := by
      dsimp [det] at heq
      linear_combination -heq
    have hdiv : p.1 ∣ a.1 - b.1 :=
      (Int.isCoprime_iff_gcd_eq_one.mpr hpprim).dvd_of_dvd_mul_left ⟨_, hcross⟩
    have hsmall : |a.1 - b.1| < p.1 := by
      have ha0 := (hS a ha).2.2.1
      have hb0 := (hS b hb).2.2.1
      have hpa : a.1 ≤ p.1 := hmax a ha
      have hpb : b.1 ≤ p.1 := hmax b hb
      exact abs_lt.mpr ⟨by omega, by omega⟩
    have hfst : a.1 = b.1 := sub_eq_zero.mp (Int.eq_zero_of_abs_lt_dvd hdiv hsmall)
    have hsnd : a.2 = b.2 := by
      rw [hfst, sub_self, mul_zero, eq_comm, mul_eq_zero] at hcross
      exact sub_eq_zero.mp (hcross.resolve_left hp0.ne')
    exact Prod.ext hfst hsnd
  let T : ℝ := 2 * V * K / (L : ℝ)
  let N : ℤ := ⌊T⌋
  have hmaps : Set.MapsTo f (S : Set (ℤ × ℤ)) (Finset.Icc (-N) N : Set ℤ) := by
    intro a ha
    obtain ⟨_, _, ha0, haV, haK⟩ := hS a ha
    have haR : 0 < (a.1 : ℝ) := by exact_mod_cast ha0
    have habs : |(det a : ℝ)| ≤ 2 * V * K := by
      simp only [det, Int.cast_sub, Int.cast_mul]
      refine (abs_sub _ _).trans ?_
      rw [abs_mul, abs_mul, abs_of_pos hpR, abs_of_pos haR]
      have h₁ := mul_le_mul hpV haK (abs_nonneg _) hV
      have h₂ := mul_le_mul haV hpK (abs_nonneg _) hV
      linarith only [h₁, h₂]
    have hcast : (f a : ℝ) * (L : ℝ) = (det a : ℝ) := by exact_mod_cast hcancel ha
    have hfabs : |(f a : ℝ)| ≤ T := by
      apply (le_div_iff₀ hLR).2
      rwa [← abs_of_pos hLR, ← abs_mul, hcast]
    have hfloor : |f a| ≤ N := Int.le_floor.mpr (by simpa only [Int.cast_abs] using hfabs)
    exact Finset.mem_Icc.mpr (abs_le.mp hfloor)
  have hcard := Finset.card_le_card_of_injOn f hmaps hinj
  have hT : 0 ≤ T := by dsimp [T]; positivity
  have hN : 0 ≤ N := Int.floor_nonneg.mpr hT
  have hsize : (((N + 1 - -N).toNat : ℕ) : ℝ) = (N : ℝ) + 1 - -(N : ℝ) := by
    exact_mod_cast Int.toNat_of_nonneg (show 0 ≤ N + 1 - -N by omega)
  calc
    (S.card : ℝ) ≤ ((Finset.Icc (-N) N).card : ℝ) := Nat.cast_le.mpr hcard
    _ ≤ 1 + 2 * T := by
      rw [Int.card_Icc, hsize]
      linarith only [show (N : ℝ) ≤ T from Int.floor_le T]
    _ = 1 + 4 * V * K / (L : ℝ) := by dsimp [T]; ring

/-- The absolute fixed-line price at a denominator pair. This counts the distinct original
triples, with no independence or rank assumption, rather than just lattice points in a
postulated fiber. -/
public theorem card_le {d e : ℕ} {F₁ q i j : ℤ} {V H : ℝ}
    {rows : Finset (ℤ × ℤ × ℤ)} (hd : 0 < d) (he : 0 < e)
    (hc : Int.gcd (F₁ * q) ((d : ℤ) * (e : ℤ)) = 1) (hdir : Int.gcd i j = 1)
    (hV : 0 ≤ V) (hH : 0 ≤ H) (hrows : ∀ p ∈ rows, Row d e F₁ q i j V H p) :
    (rows.card : ℝ) ≤ 1 + 8 * V * H / ((d : ℝ) * (e : ℝ)) := by
  classical
  rcases rows.eq_empty_or_nonempty with rfl | ⟨a, ha⟩
  · simp only [Finset.card_empty, Nat.cast_zero]
    positivity
  obtain ⟨_, B, _, _, hrecover⟩ := fixedLineCRT hd hc hdir (hrows a ha)
  let coord (p : ℤ × ℤ × ℤ) : ℤ × ℤ := (p.1, gapCoordinate i j p.2.1 p.2.2)
  have hinj : Set.InjOn coord (rows : Set (ℤ × ℤ × ℤ)) := by
    intro p hp r hr hpr
    obtain ⟨hm, hk⟩ := Prod.ext_iff.mp hpr
    refine Prod.ext hm ?_
    change gapCoordinate i j p.2.1 p.2.2 = gapCoordinate i j r.2.1 r.2.2 at hk
    rw [(hrecover p (hrows p hp)).1, (hrecover r (hrows r hr)).1, hk]
  have hL := Nat.lcm_pos hd he
  have hG : 0 < (d.gcd e : ℝ) := Nat.cast_pos.mpr (Nat.gcd_pos_of_pos_left e hd)
  have hLR : 0 < (d.lcm e : ℝ) := Nat.cast_pos.mpr hL
  have hLG : (d.lcm e : ℝ) * (d.gcd e : ℝ) = (d : ℝ) * (e : ℝ) := by
    exact_mod_cast Nat.lcm_mul_gcd d e
  rw [← Finset.card_image_of_injOn hinj]
  calc
    ((rows.image coord).card : ℝ) ≤ 1 + 4 * V * (2 * H / (d.gcd e : ℝ)) / (d.lcm e : ℝ) := by
      apply primitive_fiber_card_le hL hV (div_nonneg (by positivity) hG.le)
      intro p hp
      obtain ⟨r, hr, rfl⟩ := Finset.mem_image.mp hp
      have hrow := hrows r hr
      obtain ⟨_, _, hprim, hk, hcong⟩ := hrecover r hrow
      exact ⟨hcong, hprim, hrow.input_pos, hrow.input_le, hk⟩
    _ = 1 + 8 * V * H / ((d : ℝ) * (e : ℝ)) := by
      rw [← hLG]
      field_simp
      ring

end VerticalGapLinePrice
