module

public import Lemmas.FiniteCompletionIntegralTrace
public import Theorems.PadicStandardCharacter
import Lemmas.FiniteCompletionIntegralLattice
import Mathlib.RingTheory.DedekindDomain.FiniteAdeleRing
import Mathlib.RingTheory.Localization.NormTrace

/-! # Support of the finite-place diagonal trace phases -/

open Filter IsDedekindDomain NumberField
open scoped BigOperators Masullo nonZeroDivisors

namespace Masullo

variable {K : Type*} [Field K] [NumberField K]

/-- The positive trace phase at the finite place `v`, evaluated on the diagonal of `K`. -/
public noncomputable def finiteCompletionDiagonalPhase (v : HeightOneSpectrum (𝓞 K)) (x : K) : ℂ :=
  padicStdAddChar (finiteCompletionBasePrime v : ℕ)
    (Algebra.trace ℚ_[(finiteCompletionBasePrime v : ℕ)] (v.adicCompletion K)
      (algebraMap K (v.adicCompletion K) x))

public theorem finiteCompletionDiagonalPhase_apply (v : HeightOneSpectrum (𝓞 K)) (x : K) :
    finiteCompletionDiagonalPhase v x = padicStdAddChar (finiteCompletionBasePrime v : ℕ)
      (Algebra.trace ℚ_[(finiteCompletionBasePrime v : ℕ)] (v.adicCompletion K)
        (algebraMap K (v.adicCompletion K) x)) := by
  unfold finiteCompletionDiagonalPhase
  rfl

private theorem finiteCompletionDiagonalPhase_eq_one_of_integral
    (v : HeightOneSpectrum (𝓞 K)) (x : K)
    (hx : algebraMap K (v.adicCompletion K) x ∈ v.adicCompletionIntegers K) :
    finiteCompletionDiagonalPhase v x = 1 := by
  let := finiteCompletionIntegers_moduleFree v
  let := finiteCompletionIntegers_moduleFinite v
  let := finiteCompletionIntegers_isLocalization v
  let y : v.adicCompletionIntegers K := ⟨_, hx⟩
  unfold finiteCompletionDiagonalPhase
  rw [padicStdAddChar_eq_one_iff]
  change ‖Algebra.trace ℚ_[finiteCompletionBasePrime v] (v.adicCompletion K)
    (algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K) y)‖ ≤ 1
  rw [Algebra.trace_localization ℤ_[finiteCompletionBasePrime v]
    (ℤ_[finiteCompletionBasePrime v])⁰]
  exact PadicInt.norm_le_one _

/-- Almost all diagonal finite-place phases are one: away from finitely many
places, the diagonal lies in the completion integers and its trace is integral. -/
public theorem finiteCompletionDiagonalPhase_hasFiniteMulSupport (x : K) :
    (fun v ↦ finiteCompletionDiagonalPhase v x).HasFiniteMulSupport := by
  let a := algebraMap K (FiniteAdeleRing (𝓞 K) K) x
  refine (eventually_cofinite.mp a.cofinite_mem_adicCompletionIntegers).subset fun v hv ↦ ?_
  exact fun h ↦ hv (finiteCompletionDiagonalPhase_eq_one_of_integral v x h)

/-- The fiber of the canonical base-prime map is exactly the set of places
whose prime ideals divide the ideal generated by that rational prime. -/
public theorem finiteCompletionBasePrime_eq_iff (p : Nat.Primes) (v : HeightOneSpectrum (𝓞 K)) :
    finiteCompletionBasePrime v = p ↔
      v.asIdeal ∣ Ideal.span ({(p : 𝓞 K)} : Set (𝓞 K)) := by
  constructor
  · rintro rfl
    apply (finitePlace_dvd_primeSpan_iff (finiteCompletionBasePrime v) v).mpr
    rw [← map_natCast (algebraMap ℤ (𝓞 K)), ← Ideal.mem_under, finiteCompletionBasePrime_val]
    let u := v.under ℤ
    change ((Rat.HeightOneSpectrum.natGenerator u : ℕ) : ℤ) ∈ u.asIdeal
    apply (Ideal.apply_mem_of_equiv_iff (f := Rat.IsIntegralClosure.intEquiv ℤ)).mp
    rw [map_natCast]
    exact (Rat.HeightOneSpectrum.natGenerator_dvd_iff u).mp dvd_rfl
  · intro h
    let : Fact (p : ℕ).Prime := ⟨p.property⟩
    exact Subtype.ext (finiteCompletionBasePrime_eq_of_dvd_primeSpan (p : ℕ) ⟨v, h⟩)

/-- Group the supported factors over a finite set of rational primes. Completing
an index fiber adds only factors equal to one. -/
public theorem finprod_finiteCompletionDiagonalPhase_group (x : K) (T : Finset Nat.Primes)
    (hT : ∀ v, finiteCompletionDiagonalPhase v x ≠ 1 → finiteCompletionBasePrime v ∈ T) :
    (∏ᶠ v, finiteCompletionDiagonalPhase v x) = ∏ p ∈ T,
      letI : Fact (p : ℕ).Prime := ⟨p.property⟩
      letI := finiteCompletionOverPrimeFintype (K := K) (p : ℕ)
      ∏ v : {v : HeightOneSpectrum (𝓞 K) // v.asIdeal ∣ Ideal.span ({(p : 𝓞 K)} : Set (𝓞 K))},
        finiteCompletionDiagonalPhase v.1 x := by
  classical
  let hf := finiteCompletionDiagonalPhase_hasFiniteMulSupport x
  let S := hf.toFinset
  have hS (v : HeightOneSpectrum (𝓞 K)) : v ∈ S ↔ finiteCompletionDiagonalPhase v x ≠ 1 :=
    Set.Finite.mem_toFinset hf
  rw [finprod_eq_prod (fun v ↦ finiteCompletionDiagonalPhase v x) hf,
    ← Finset.prod_fiberwise_of_maps_to (t := T) (g := finiteCompletionBasePrime)
      (fun v hv ↦ hT v ((hS v).mp hv))]
  apply Finset.prod_congr rfl
  intro p _
  let : Fact (p : ℕ).Prime := ⟨p.property⟩
  let fiber : Set (HeightOneSpectrum (𝓞 K)) :=
    {v | v.asIdeal ∣ Ideal.span ({(p : 𝓞 K)} : Set (𝓞 K))}
  let : Fintype fiber := finiteCompletionOverPrimeFintype (K := K) (p : ℕ)
  change _ = ∏ v : fiber, finiteCompletionDiagonalPhase v.1 x
  rw [Finset.prod_set_coe (f := fun v ↦ finiteCompletionDiagonalPhase v x) fiber]
  apply Finset.prod_subset
  · intro v hv
    exact Set.mem_toFinset.mpr ((finiteCompletionBasePrime_eq_iff p v).mp (Finset.mem_filter.mp hv).2)
  · intro v hv hvS
    by_contra hn
    exact hvS (Finset.mem_filter.mpr
      ⟨(hS v).mpr hn, (finiteCompletionBasePrime_eq_iff p v).mpr (Set.mem_toFinset.mp hv)⟩)

end Masullo
