module

public import Lemmas.TranslatedOutputStrip
import Mathlib.Data.Int.Interval
import Mathlib.GroupTheory.SpecificGroups.Cyclic.Subgroup
import Mathlib.RingTheory.Coprime.Lemmas
import Mathlib.Tactic.LinearCombination

/-!
# The integer step and run in a translated output strip

Source: `472c8e5d:.godel/alice/adaptive-complement-interval.md:15–32`, used in
consequence 3 of `1d3802f7:.godel/alice/two-cofactor-strips.md`. This extends
`TranslatedOutputStrip` from `c8e4024a`: We prove the line step in the original row
lattice and the two run bounds for a finite selection of points. The selection
need not fill the run, and the step can have zero determinant quotient. This is
only the geometric input, not the exceptional-direction count or a smoothness or
occupancy estimate.

Owning session: `01a20938-230d-71be-9082-772ff1e0dec6`.
-/

namespace TranslatedOutputStrip

private def rowForm (x₁ x₂ : ℤ) : (ℤ × ℤ) →+ ℤ where
  toFun z := x₁ * z.2 - x₂ * z.1
  map_zero' := by change x₁ * 0 - x₂ * 0 = 0; simp
  map_add' a b := by
    change x₁ * (a.2 + b.2) - x₂ * (a.1 + b.1) =
      (x₁ * a.2 - x₂ * a.1) + (x₁ * b.2 - x₂ * b.1)
    ring

/-- The original lattice of integer pairs whose signed row determinant is a
multiple of `q`, before imposing any first-coordinate divisor. -/
public def rowLattice (q : ℕ) (x₁ x₂ : ℤ) : AddSubgroup (ℤ × ℤ) :=
  (AddSubgroup.zmultiples (q : ℤ)).comap (rowForm x₁ x₂)

/-- The signed integral determinant quotient, exact on `rowLattice`. -/
@[expose] public def rowQuotient (q : ℕ) (x₁ x₂ : ℤ) (z : ℤ × ℤ) : ℤ :=
  (x₁ * z.2 - x₂ * z.1) / (q : ℤ)

/-- Membership in the original lattice is the exact signed row equation. -/
public theorem mem_rowLattice_iff {q : ℕ} {x₁ x₂ : ℤ} {z : ℤ × ℤ} :
    z ∈ rowLattice q x₁ x₂ ↔ x₁ * z.2 - x₂ * z.1 = (q : ℤ) * rowQuotient q x₁ x₂ z := by
  change rowForm x₁ x₂ z ∈ AddSubgroup.zmultiples (q : ℤ) ↔ _
  rw [Int.mem_zmultiples_iff]
  change (q : ℤ) ∣ x₁ * z.2 - x₂ * z.1 ↔ _
  exact ⟨fun h ↦ by simpa only [rowQuotient, mul_comm (q : ℤ)] using (Int.ediv_mul_cancel h).symm,
    fun h ↦ ⟨_, h⟩⟩

/-- The intersection of the row lattice with the rational line through `a`
is generated by a vector with positive first coordinate. The cross-product
equality describes this line in the original `(z₁,z₂)` coordinates. -/
public theorem rowLattice_line_step {q : ℕ} {x₁ x₂ : ℤ} {a : ℤ × ℤ}
    (ha : a ∈ rowLattice q x₁ x₂) (ha₁ : a.1 ≠ 0) :
    ∃ v : ℤ × ℤ, 0 < v.1 ∧ ∀ w : ℤ × ℤ,
      (w ∈ rowLattice q x₁ x₂ ∧ a.1 * w.2 = w.1 * a.2) ↔ ∃ n : ℤ, w = n • v := by
  let H := rowLattice q x₁ x₂ ⊓ (rowForm a.1 a.2).ker
  have hH (w : ℤ × ℤ) : w ∈ H ↔ w ∈ rowLattice q x₁ x₂ ∧ a.1 * w.2 = w.1 * a.2 := by
    change (w ∈ rowLattice q x₁ x₂ ∧ a.1 * w.2 - a.2 * w.1 = 0) ↔ _
    rw [sub_eq_zero, mul_comm a.2 w.1]
  -- The homogeneous line in the base lattice embeds into `ℤ` by first projection.
  let f := (AddMonoidHom.fst ℤ ℤ).comp H.subtype
  have hinj : Function.Injective f := by
    intro p u hpu
    have h₁ : (p : ℤ × ℤ).1 = (u : ℤ × ℤ).1 := hpu
    have h₂ := ((hH _).mp p.property).2.trans (h₁ ▸ ((hH _).mp u.property).2).symm
    exact Subtype.ext (Prod.ext h₁ (mul_left_cancel₀ ha₁ h₂))
  obtain ⟨g, hg⟩ := H.isAddCyclic_iff_exists_zmultiples_eq.mp (isAddCyclic_of_injective f hinj)
  have hg₁ : g.1 ≠ 0 := by
    have ham : a ∈ AddSubgroup.zmultiples g := hg ▸ (hH a).mpr ⟨ha, rfl⟩
    obtain ⟨n, hn⟩ := AddSubgroup.mem_zmultiples_iff.mp ham
    have h₁ : n * g.1 = a.1 := congrArg Prod.fst hn
    intro hz
    exact ha₁ (by simpa [hz] using h₁.symm)
  obtain ⟨v, hv₁, hv⟩ : ∃ v : ℤ × ℤ, 0 < v.1 ∧ AddSubgroup.zmultiples v = H := by
    rcases lt_or_gt_of_ne hg₁ with h | h
    · exact ⟨-g, neg_pos.mpr h, AddSubgroup.zmultiples_neg.trans hg⟩
    · exact ⟨g, h, hg⟩
  refine ⟨v, hv₁, fun w ↦ ?_⟩
  rw [← hH, ← hv, AddSubgroup.mem_zmultiples_iff]
  exact exists_congr (fun _ ↦ eq_comm)

private theorem dvd_mul_iff_step {e b : ℤ} (he : 0 < e) (n : ℤ) :
    e ∣ n * b ↔ e / (Int.gcd e b : ℤ) ∣ n := by
  let g : ℤ := Int.gcd e b
  have hgₙ := Int.gcd_pos_of_ne_zero_left b he.ne'
  have hg : 0 < g := by
    change 0 < (Int.gcd e b : ℤ)
    exact_mod_cast hgₙ
  have hdₑ : g ∣ e := Int.gcd_dvd_left e b
  have hdᵦ : g ∣ b := Int.gcd_dvd_right e b
  have hₑ : g * (e / g) = e := (mul_comm _ _).trans (Int.ediv_mul_cancel hdₑ)
  have hᵦ : g * (b / g) = b := (mul_comm _ _).trans (Int.ediv_mul_cancel hdᵦ)
  have hc : IsCoprime (e / g) (b / g) := by
    apply Int.isCoprime_iff_gcd_eq_one.mpr
    rw [Int.gcd_ediv hdₑ hdᵦ]
    simpa [g] using Nat.div_self hgₙ
  change (e ∣ n * b) ↔ (e / g ∣ n)
  have hmul : g * (n * (b / g)) = n * b := by rw [mul_left_comm, hᵦ]
  have hcancel : e ∣ n * b ↔ e / g ∣ n * (b / g) := calc
    e ∣ n * b ↔ g * (e / g) ∣ g * (n * (b / g)) := by rw [hₑ, hmul]
    _ ↔ _ := mul_dvd_mul_iff_left hg.ne'
  exact hcancel.trans ⟨hc.dvd_of_dvd_mul_right, fun h ↦ h.mul_right _⟩

private theorem abs_cast_sub_le {a b : ℤ} {c H : ℝ}
    (ha : |(a : ℝ) - c| ≤ H) (hb : |(b : ℝ) - c| ≤ H) :
    |((a - b : ℤ) : ℝ)| ≤ 2 * H := by
  rw [Int.cast_sub, ← sub_sub_sub_cancel_right (a : ℝ) (b : ℝ) c]
  exact (abs_sub _ _).trans (by simpa only [two_mul] using add_le_add ha hb)

private theorem run_bound {m : ℕ} {a b k x : ℤ} {H : ℝ} (hk : 0 ≤ k)
    (hm : (m : ℤ) ≤ b - a) (hspan : |(((b - a) * k * x : ℤ) : ℝ)| ≤ 2 * H) :
    (m : ℝ) * (k : ℝ) * |(x : ℝ)| ≤ 2 * H := by
  have hδ : (m : ℝ) ≤ (b : ℝ) - (a : ℝ) := by exact_mod_cast hm
  have hk' : 0 ≤ (k : ℝ) := by exact_mod_cast hk
  have hab : 0 ≤ (b : ℝ) - (a : ℝ) := (Nat.cast_nonneg m).trans hδ
  simp only [Int.cast_mul, Int.cast_sub, abs_mul, abs_of_nonneg hab, abs_of_nonneg hk'] at hspan
  exact (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hδ hk') (abs_nonneg _)).trans hspan

/-- A nonsingleton finite subset of the thin translated strip lies in one run
of step `k • v`, where `v` generates the **base** row lattice on its rational
line. Both bounds use the same length in integer steps, without requiring the
selected points to be consecutive or the quotient of `v` to be nonzero. -/
public theorem translatedRectangle_integerRun {q : ℕ} {x₁ x₂ e : ℤ} {S : Finset (ℤ × ℤ)}
    {c d L W : ℝ} (hq : q.Prime) (hqx : ¬ (q : ℤ) ∣ x₁ * x₂)
    (hx₁ : 0 < x₁) (_hx₂ : 0 < x₂) (he : 0 < e)
    (hS : ∀ z ∈ S, z ∈ rowLattice q x₁ x₂) (hdiv : ∀ z ∈ S, e ∣ z.1)
    (hbox : ∀ z ∈ S, |(z.1 : ℝ) - c| ≤ L ∧ |(rowQuotient q x₁ x₂ z : ℝ) - d| ≤ W)
    (harea : 8 * L * W < ((e * x₁ : ℤ) : ℝ)) (hW : 2 * W < min (x₁ : ℝ) (x₂ : ℝ))
    (hcard : 2 ≤ S.card) :
    ∃ z₀ ∈ S, ∃ v ∈ rowLattice q x₁ x₂,
      0 < v.1 ∧ v.2 ≠ 0 ∧
      (∀ w : ℤ × ℤ, (w ∈ rowLattice q x₁ x₂ ∧ v.1 * w.2 = w.1 * v.2) ↔
        ∃ n : ℤ, w = n • v) ∧
      let k : ℤ := e / (Int.gcd e |v.1| : ℤ)
      0 < k ∧ (∀ n : ℤ, e ∣ n * v.1 ↔ k ∣ n) ∧
      (∀ z ∈ S, ∃ n : ℤ, z = z₀ + (n * k) • v) ∧
      ((S.card - 1 : ℕ) : ℝ) * (k : ℝ) * |(v.1 : ℝ)| ≤ 2 * L ∧
      ((S.card - 1 : ℕ) : ℝ) * (k : ℝ) * |(rowQuotient q x₁ x₂ v : ℝ)| ≤ 2 * W := by
  classical
  let T := rowQuotient q x₁ x₂
  have hrow (z : ℤ × ℤ) (hz : z ∈ (S : Set (ℤ × ℤ))) :
      x₁ * z.2 - x₂ * z.1 = (q : ℤ) * T z := mem_rowLattice_iff.mp (hS z hz)
  obtain ⟨z₀, hz₀, u, hu, hne⟩ := Finset.one_lt_card.mp (by omega : 1 < S.card)
  have hcoords := originalCoords_ne hq hqx hrow (fun z hz ↦ (hbox z hz).2) hW hz₀ hu hne
  let a := u - z₀
  have ha : a ∈ rowLattice q x₁ x₂ := AddSubgroup.sub_mem _ (hS u hu) (hS z₀ hz₀)
  have ha₁ : a.1 ≠ 0 := sub_ne_zero.mpr hcoords.1.symm
  have ha₂ : a.2 ≠ 0 := sub_ne_zero.mpr hcoords.2.symm
  obtain ⟨v, hv₁, hgen⟩ := rowLattice_line_step ha ha₁
  have hv := (hgen v).mpr ⟨1, (one_zsmul v).symm⟩
  have hv₂ : v.2 ≠ 0 := by
    intro hz
    have hc := hv.2
    rw [hz, mul_zero] at hc
    exact (mul_ne_zero hv₁.ne' ha₂) hc.symm
  have hgen' (w : ℤ × ℤ) :
      (w ∈ rowLattice q x₁ x₂ ∧ v.1 * w.2 = w.1 * v.2) ↔ ∃ n : ℤ, w = n • v := by
    rw [← hgen]
    refine and_congr_right (fun _ ↦ ⟨fun h ↦ ?_, fun h ↦ ?_⟩)
    · apply mul_left_cancel₀ hv₁.ne'
      linear_combination a.1 * h + w.1 * hv.2
    · apply mul_left_cancel₀ ha₁
      linear_combination v.1 * h - w.1 * hv.2
  have hdiff (z : ℤ × ℤ) (hz : z ∈ S) :
      x₁ * (z.2 - z₀.2) - x₂ * (z.1 - z₀.1) = (q : ℤ) * (T z - T z₀) := by
    linear_combination hrow z hz - hrow z₀ hz₀
  let k : ℤ := e / (Int.gcd e |v.1| : ℤ)
  have hk : 0 < k := Int.ediv_pos_of_pos_of_dvd he (Int.natCast_nonneg _) (Int.gcd_dvd_left _ _)
  have hstep (n : ℤ) : e ∣ n * v.1 ↔ k ∣ n := by
    simpa [k, abs_of_pos hv₁] using dvd_mul_iff_step (b := v.1) he n
  have hrun (z : ℤ × ℤ) (hz : z ∈ S) : ∃ n : ℤ, z = z₀ + (n * k) • v := by
    -- The row equations transfer the vanishing strip determinant back to the original lattice.
    have hc : a.1 * (z - z₀).2 = (z - z₀).1 * a.2 := by
      have hdet := stripDet_eq_zero hq hqx hrow hdiv hbox harea hz₀ hu hz
      apply sub_eq_zero.mp
      apply mul_left_cancel₀ hx₁.ne'
      change x₁ * ((u.1 - z₀.1) * (z.2 - z₀.2) - (z.1 - z₀.1) * (u.2 - z₀.2)) = x₁ * 0
      linear_combination (u.1 - z₀.1) * hdiff z hz - (z.1 - z₀.1) * hdiff u hu + (q : ℤ) * hdet
    obtain ⟨j, hj⟩ := (hgen (z - z₀)).mp ⟨AddSubgroup.sub_mem _ (hS z hz) (hS z₀ hz₀), hc⟩
    have hj₁ : z.1 - z₀.1 = j * v.1 := congrArg Prod.fst hj
    have hdvd : e ∣ j * v.1 := hj₁ ▸ dvd_sub (hdiv z hz) (hdiv z₀ hz₀)
    obtain ⟨n, hn⟩ := (hstep j).mp hdvd
    have hz' : z = z₀ + j • v := by rw [← hj, add_sub_cancel]
    exact ⟨n, by simpa [hn, mul_comm k n] using hz'⟩
  refine ⟨z₀, hz₀, v, hv.1, hv₁, hv₂, hgen', hk, hstep, hrun, ?_⟩
  -- Count distinct coefficients inside the closed interval between the attained extremes.
  let index (z : {z // z ∈ S}) : ℤ := (hrun z.1 z.2).choose
  have hindex (z : {z // z ∈ S}) : (z : ℤ × ℤ) = z₀ + (index z * k) • v :=
    (hrun z.1 z.2).choose_spec
  have hi : Function.Injective index := by
    intro p u h
    exact Subtype.ext ((hindex p).trans (h ▸ hindex u).symm)
  let I := S.attach.image index
  have hI : I.Nonempty := ⟨index ⟨z₀, hz₀⟩, Finset.mem_image.mpr ⟨_, Finset.mem_attach _ _, rfl⟩⟩
  let lo := I.min' hI
  let hi' := I.max' hI
  have hlo : lo ∈ I := I.min'_mem hI
  have hhi : hi' ∈ I := I.max'_mem hI
  have hle : lo ≤ hi' := I.le_max' lo hlo
  have hIcc : I ⊆ Finset.Icc lo hi' := fun n hn ↦
    Finset.mem_Icc.mpr ⟨I.min'_le n hn, I.le_max' n hn⟩
  have hcount := Finset.card_le_card hIcc
  rw [Int.card_Icc, show I.card = S.card by
    rw [Finset.card_image_of_injective _ hi, Finset.card_attach]] at hcount
  have hm : ((S.card - 1 : ℕ) : ℤ) ≤ hi' - lo := by omega
  obtain ⟨p, _, hp⟩ := Finset.mem_image.mp hlo
  obtain ⟨r, _, hr⟩ := Finset.mem_image.mp hhi
  have hp' := (hindex p).trans (by rw [hp])
  have hr' := (hindex r).trans (by rw [hr])
  have hspan : (r : ℤ × ℤ) - p = ((hi' - lo) * k) • v := by
    rw [hr', hp']
    simp only [add_sub_add_left_eq_sub, sub_smul, sub_mul]
  have hspan₁ : r.1.1 - p.1.1 = (hi' - lo) * k * v.1 := congrArg Prod.fst hspan
  have hspanT : T r - T p = (hi' - lo) * k * T v := by
    have hf := congrArg (rowForm x₁ x₂) hspan
    rw [map_sub, map_zsmul] at hf
    change (x₁ * r.1.2 - x₂ * r.1.1) - (x₁ * p.1.2 - x₂ * p.1.1) =
      ((hi' - lo) * k) * (x₁ * v.2 - x₂ * v.1) at hf
    rw [hrow r r.2, hrow p p.2, mem_rowLattice_iff.mp hv.1] at hf
    apply mul_left_cancel₀ (show (q : ℤ) ≠ 0 by exact_mod_cast hq.ne_zero)
    linear_combination hf
  have hLspan := abs_cast_sub_le (hbox r r.2).1 (hbox p p.2).1
  have hWspan := abs_cast_sub_le (hbox r r.2).2 (hbox p p.2).2
  rw [hspan₁] at hLspan
  change |((T r - T p : ℤ) : ℝ)| ≤ 2 * W at hWspan
  rw [hspanT] at hWspan
  exact ⟨run_bound hk.le hm hLspan, run_bound hk.le hm hWspan⟩

end TranslatedOutputStrip
