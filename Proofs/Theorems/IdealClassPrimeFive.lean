module

public import Theorems.IdealClassPrimeTwo
import Mathlib.Algebra.Field.ZMod

/-!
# The prime over five in ℚ(√-5)

This supplies the ideal-theoretic input at five for Masullo's finite Euler
product (3.2.1.7), p. 124, without constructing the idelic character.
-/

open NumberField IsDedekindDomain

namespace Masullo

local notation "O" => 𝓞 QSqrtNegFive

local instance : Fact (Nat.Prime 5) := ⟨by decide⟩

/-- Reduction modulo five sending `√-5` to zero. -/
public noncomputable def qSqrtNegFiveReductionFive : O →+* ZMod 5 :=
  ((QuadraticAlgebra.lift ⟨0, by decide⟩).comp qSqrtNegFiveIntegersEquiv.toAlgHom).toRingHom

/-- Reduction modulo five takes the constant coordinate in the integral basis. -/
public theorem qSqrtNegFiveReductionFive_apply (z : O) :
    qSqrtNegFiveReductionFive z = ((qSqrtNegFiveIntegersEquiv z).re : ZMod 5) := by
  change _ • (1 : ZMod 5) + _ • (0 : ZMod 5) = _
  simp [zsmul_eq_mul]

private theorem reductionFive_surjective : Function.Surjective qSqrtNegFiveReductionFive := by
  intro z
  obtain ⟨n, rfl⟩ := ZMod.intCast_surjective z
  exact ⟨n, map_intCast qSqrtNegFiveReductionFive n⟩

private theorem reductionFive_five : qSqrtNegFiveReductionFive 5 = 0 := by
  rw [map_ofNat]
  decide

private theorem sqrt_sq : qSqrtNegFiveSqrt ^ 2 = (-5 : O) := by
  apply qSqrtNegFiveIntegersEquiv.injective
  rw [map_pow, qSqrtNegFiveIntegersEquiv_sqrt, pow_two, QuadraticAlgebra.omega_mul_omega_eq_mk,
    map_neg, map_ofNat]
  ext <;> norm_num [QuadraticAlgebra.re_ofNat, QuadraticAlgebra.im_ofNat]

/-- The reduction kernel is generated by `√-5` alone. -/
public theorem qSqrtNegFiveReductionFive_ker :
    RingHom.ker qSqrtNegFiveReductionFive = Ideal.span {qSqrtNegFiveSqrt} := by
  refine le_antisymm (fun z hz ↦ ?_) ((Ideal.span_singleton_le_iff_mem _).mpr ?_)
  · have h := RingHom.mem_ker.mp hz
    rw [qSqrtNegFiveReductionFive_apply, ZMod.intCast_zmod_eq_zero_iff_dvd] at h
    obtain ⟨k, hk⟩ := h
    -- `5k + y√-5 = √-5 (y - k√-5)`.
    refine Ideal.mem_span_singleton.mpr ⟨qSqrtNegFiveIntegersEquiv.symm
      ⟨(qSqrtNegFiveIntegersEquiv z).im, -k⟩, ?_⟩
    apply qSqrtNegFiveIntegersEquiv.injective
    simp only [map_mul, qSqrtNegFiveIntegersEquiv_sqrt, AlgEquiv.apply_symm_apply,
      QuadraticAlgebra.omega_mul_mk, zero_mul, add_zero]
    ext <;> simp [hk]
  · apply RingHom.mem_ker.mpr
    simp [qSqrtNegFiveReductionFive_apply, qSqrtNegFiveIntegersEquiv_sqrt]

/-- The finite place cut out by reduction modulo five. -/
public noncomputable def qSqrtNegFivePrimeFive : HeightOneSpectrum O where
  asIdeal := RingHom.ker qSqrtNegFiveReductionFive
  isPrime := RingHom.ker_isPrime qSqrtNegFiveReductionFive
  ne_bot := by
    intro h
    have h₅ : (5 : O) ∈ RingHom.ker qSqrtNegFiveReductionFive :=
      RingHom.mem_ker.mpr reductionFive_five
    rw [h, Ideal.mem_bot] at h₅
    exact (by norm_num : (5 : O) ≠ 0) h₅

/-- The place over five is the principal ideal `(√-5)` in the full ring of integers. -/
public theorem qSqrtNegFivePrimeFive_asIdeal :
    qSqrtNegFivePrimeFive.asIdeal = Ideal.span {qSqrtNegFiveSqrt} :=
  qSqrtNegFiveReductionFive_ker

/-- The residue field of the place over five is `𝔽₅`. -/
public noncomputable def qSqrtNegFivePrimeFive_residueEquiv :
    O ⧸ qSqrtNegFivePrimeFive.asIdeal ≃+* ZMod 5 :=
  qSqrtNegFiveReductionFive.quotientKerEquivOfSurjective reductionFive_surjective

/-- The absolute ideal norm of the place over five is five. -/
public theorem qSqrtNegFivePrimeFive_absNorm : qSqrtNegFivePrimeFive.asIdeal.absNorm = 5 := by
  rw [Ideal.absNorm_eq_natCard, Nat.card_congr qSqrtNegFivePrimeFive_residueEquiv.toEquiv,
    Nat.card_eq_fintype_card, ZMod.card]

/-- The place lies over the ideal `(5)` in `ℤ`. -/
public theorem qSqrtNegFivePrimeFive_under :
    qSqrtNegFivePrimeFive.asIdeal.under ℤ = Ideal.span {(5 : ℤ)} := by
  ext n
  change qSqrtNegFiveReductionFive (algebraMap ℤ O n) = 0 ↔ _
  rw [algebraMap_int_eq]
  change qSqrtNegFiveReductionFive (n : O) = 0 ↔ _
  rw [map_intCast, ZMod.intCast_zmod_eq_zero_iff_dvd, Nat.cast_ofNat, Ideal.mem_span_singleton]

/-- Every prime ideal containing five is the indicated place. -/
public theorem qSqrtNegFivePrimeFive_unique (P : Ideal O) (hP : P.IsPrime)
    (h₅ : (5 : O) ∈ P) : P = qSqrtNegFivePrimeFive.asIdeal := by
  have ha : qSqrtNegFiveSqrt ∈ P :=
    (hP.pow_mem_iff_mem 2 (by decide)).mp (sqrt_sq ▸ P.neg_mem h₅)
  have hmax :=
    RingHom.ker_isMaximal_of_surjective qSqrtNegFiveReductionFive reductionFive_surjective
  apply (hmax.eq_of_le hP.ne_top ?_).symm
  change qSqrtNegFivePrimeFive.asIdeal ≤ P
  rw [qSqrtNegFivePrimeFive_asIdeal]
  exact (Ideal.span_singleton_le_iff_mem _).mpr ha

/-- The place over five represents the identity ideal class. -/
public theorem qSqrtNegFivePrimeFive_class_eq_one :
    qSqrtNegFivePlaceClass qSqrtNegFivePrimeFive = 1 := by
  apply (qSqrtNegFive_placeClass_eq_one_iff _).mpr
  rw [qSqrtNegFivePrimeFive_asIdeal]
  infer_instance

end Masullo
