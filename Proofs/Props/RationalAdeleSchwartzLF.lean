module

public import Props.RationalAdeleStageResidual

/-! # The rational Schwartz inductive-limit topology

Use exactly the complex seminorms continuous on every product Schwartz
stage. This is the finest locally convex vector space topology for the
stage assemblies. The representative-line readings split the assemblies
in this topology.
-/

open scoped SchwartzMap

namespace Masullo

local notation "L" => rationalAdeleFactorialLevel
local notation "Profiles" n => Fin ((L n) ^ 2) → 𝓢(ℝ, ℂ)

/-- The algebraic union of the rational stages, with a separate type for
its inductive-limit topology rather than the ambient function topology. -/
@[expose] public def RationalAdeleSchwartzLF := ↥rationalAdeleSchwartzStageUnion

local notation "E" => RationalAdeleSchwartzLF

public noncomputable instance : AddCommGroup E := inferInstanceAs <|
  AddCommGroup ↥rationalAdeleSchwartzStageUnion

public noncomputable instance : Module ℂ E := inferInstanceAs <|
  Module ℂ ↥rationalAdeleSchwartzStageUnion

private noncomputable def ofUnion : ↥rationalAdeleSchwartzStageUnion ≃ₗ[ℂ] E :=
  LinearEquiv.refl ℂ _

/-- Forget the topology, retaining the underlying adelic function. -/
public noncomputable def RationalAdeleSchwartzLF.toUnion : E →ₗ[ℂ]
    ↥rationalAdeleSchwartzStageUnion := ofUnion.symm.toLinearMap

/-- LF elements are equal when their underlying adelic functions are equal. -/
public theorem RationalAdeleSchwartzLF.ext {f g : E} (h : f.toUnion.val = g.toUnion.val) :
    f = g := ofUnion.symm.injective (Subtype.ext h)

/-- The algebraic stage assembly, now with codomain the LF space. -/
public noncomputable def rationalAdeleLFAssemblyLinear (n : ℕ) : (Profiles n) →ₗ[ℂ] E :=
  ofUnion.toLinearMap.comp (rationalAdeleFactorialStageAssembly n)

/-- The representative-line reading on the LF space. -/
public noncomputable def rationalAdeleLFReadLinear (n : ℕ) : E →ₗ[ℂ] (Profiles n) :=
  (rationalAdeleFactorialStageRead n).comp RationalAdeleSchwartzLF.toUnion

/-- The seminorms admitted by the inductive topology. -/
@[expose] public def RationalAdeleLFSeminorm :=
  {p : Seminorm ℂ E // ∀ n, Continuous (p.comp (rationalAdeleLFAssemblyLinear n))}

/-- The family of all stagewise continuous seminorms. -/
@[expose] public def rationalAdeleLFSeminorms : SeminormFamily ℂ E RationalAdeleLFSeminorm := fun p ↦ p.val

public noncomputable instance rationalAdeleLFTopology : TopologicalSpace E :=
  rationalAdeleLFSeminorms.moduleFilterBasis.topology

public theorem rationalAdeleLF_withSeminorms : WithSeminorms rationalAdeleLFSeminorms := ⟨rfl⟩

public instance : PolynormableSpace ℂ E := rationalAdeleLF_withSeminorms.toPolynormableSpace
public instance : IsTopologicalAddGroup E := rationalAdeleLF_withSeminorms.isTopologicalAddGroup
public instance : ContinuousSMul ℂ E := rationalAdeleLF_withSeminorms.continuousSMul

public noncomputable instance : Module ℝ E := Module.restrictScalars ℝ ℂ E
public instance : IsScalarTower ℝ ℂ E := IsScalarTower.restrictScalars ℝ ℂ E
public instance : LocallyConvexSpace ℝ E := rationalAdeleLF_withSeminorms.toLocallyConvexSpace

/-- The assemblies are continuous for the topology generated by the admitted seminorms. -/
public noncomputable def rationalAdeleLFAssembly (n : ℕ) : (Profiles n) →L[ℂ] E where
  toLinearMap := rationalAdeleLFAssemblyLinear n
  cont := rationalAdeleLF_withSeminorms.continuous_of_continuous_comp _ fun p ↦ p.property n

/-- A linear map into a seminorm-defined space is continuous out of the
inductive limit exactly when it is continuous on each stage. -/
public theorem rationalAdeleLF_continuous_iff {F : Type*} [AddCommGroup F] [Module ℂ F]
    [TopologicalSpace F] [PolynormableSpace ℂ F] (g : E →ₗ[ℂ] F) :
    Continuous g ↔ ∀ n, Continuous (g.comp (rationalAdeleLFAssemblyLinear n)) := by
  refine ⟨fun h n ↦ h.comp (rationalAdeleLFAssembly n).continuous, fun h ↦ ?_⟩
  apply (PolynormableSpace.withSeminorms ℂ F).continuous_of_continuous_comp
  intro p
  exact rationalAdeleLF_withSeminorms.continuous_seminorm
    ⟨p.val.comp g, fun n ↦ p.property.comp (h n)⟩

/-- In Lean's reverse inclusion order on topologies, the LF topology is
below every seminorm-defined topology making the stage assemblies continuous. -/
public theorem rationalAdeleLF_finest (t : TopologicalSpace E)
    (ht : @PolynormableSpace ℂ E _ _ _ t)
    (h : ∀ n, @Continuous (Profiles n) E _ t (rationalAdeleLFAssemblyLinear n)) :
    rationalAdeleLFTopology ≤ t := by
  let e : E →ₗ[ℂ] E := LinearMap.id
  have he := (@rationalAdeleLF_continuous_iff E _ _ t ht e).mpr h
  change @Continuous E E rationalAdeleLFTopology t id at he
  exact (@continuous_id_iff_le E rationalAdeleLFTopology t).mp he

/-- The stage readings are continuous on the LF space, not just on each stage. -/
public noncomputable def rationalAdeleLFRead (n : ℕ) : E →L[ℂ] (Profiles n) where
  toLinearMap := rationalAdeleLFReadLinear n
  cont := by
    let _ : PolynormableSpace ℂ (Profiles n) :=
      (withSeminorms_pi fun _ ↦ schwartz_withSeminorms ℂ ℝ ℂ).toPolynormableSpace
    exact (rationalAdeleLF_continuous_iff _).mpr fun m ↦
      rationalAdeleFactorialStageRead_continuous_on_stage m n

public theorem rationalAdeleLFAssemblyLinear_toUnion (n : ℕ) (b : Profiles n) :
    (rationalAdeleLFAssemblyLinear n b).toUnion = rationalAdeleFactorialStageAssembly n b := by rfl

public theorem rationalAdeleLFAssembly_toUnion (n : ℕ) (b : Profiles n) :
    (rationalAdeleLFAssembly n b).toUnion = rationalAdeleFactorialStageAssembly n b := by rfl

public theorem rationalAdeleLFRead_eq_stageRead (n : ℕ) (f : E) :
    rationalAdeleLFRead n f = rationalAdeleFactorialStageRead n f.toUnion := by rfl

/-- Every function in the stage is recovered by reading and assembling at that stage. -/
public theorem rationalAdeleLFAssembly_read (n : ℕ) (f : E)
    (hf : f.toUnion.val ∈ rationalAdeleSchwartzStage (L n)) :
    rationalAdeleLFAssembly n (rationalAdeleLFRead n f) = f := by
  apply ofUnion.symm.injective
  change RationalAdeleSchwartzLF.toUnion _ = f.toUnion
  apply Subtype.ext
  rw [rationalAdeleLFAssembly_toUnion, rationalAdeleFactorialStageAssembly_val,
    rationalAdeleLFRead_eq_stageRead,
    rationalAdeleFactorialStageRead_eq_coordinates _ _ hf, LinearEquiv.symm_apply_apply]

/-- At the same stage, reading the assembled function recovers its profiles. -/
public theorem rationalAdeleLFRead_leftInverse (n : ℕ) :
    Function.LeftInverse (rationalAdeleLFRead n) (rationalAdeleLFAssembly n) := by
  intro b
  let g := (rationalAdeleStageCoordinates (rationalAdeleFactorialLevel_pos n)).symm b
  have hg : (rationalAdeleFactorialStageAssembly n b).val ∈ rationalAdeleSchwartzStage (L n) := by
    rw [rationalAdeleFactorialStageAssembly_val]
    exact g.property
  rw [rationalAdeleLFRead_eq_stageRead, rationalAdeleLFAssembly_toUnion,
    rationalAdeleFactorialStageRead_eq_coordinates n _ hg]
  have he : (⟨(rationalAdeleFactorialStageAssembly n b).val, hg⟩ :
      rationalAdeleSchwartzStage (L n)) = g :=
    Subtype.ext (rationalAdeleFactorialStageAssembly_val n b)
  rw [he, LinearEquiv.apply_symm_apply]

/-- The readings separate points: Read two functions in a stage containing both. -/
public instance : T2Space E := by
  apply T2Space.of_injective_continuous (f := fun (f : E) (n : ℕ) ↦ rationalAdeleLFRead n f) _
    (continuous_pi fun n ↦ (rationalAdeleLFRead n).continuous)
  intro f g h
  obtain ⟨m, hm⟩ := mem_rationalAdeleSchwartzStageUnion.mp f.toUnion.property
  obtain ⟨n, hn⟩ := mem_rationalAdeleSchwartzStageUnion.mp g.toUnion.property
  let k := max m n
  have hf := rationalAdeleSchwartzStage_mono (rationalAdeleFactorialLevel_dvd (le_max_left m n)) hm
  have hg := rationalAdeleSchwartzStage_mono (rationalAdeleFactorialLevel_dvd (le_max_right m n)) hn
  have he : rationalAdeleLFRead k f = rationalAdeleLFRead k g := congrFun h k
  rw [← rationalAdeleLFAssembly_read k f hf, ← rationalAdeleLFAssembly_read k g hg, he]

/-- Each stage embeds as a closed subspace with its original product Schwartz topology. -/
public theorem rationalAdeleLFAssembly_isClosedEmbedding (n : ℕ) :
    Topology.IsClosedEmbedding (rationalAdeleLFAssembly n) :=
  (rationalAdeleLFRead_leftInverse n).isClosedEmbedding (rationalAdeleLFRead n).continuous
    (rationalAdeleLFAssembly n).continuous

end Masullo
