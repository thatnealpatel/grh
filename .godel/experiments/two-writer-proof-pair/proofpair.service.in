[Unit]
Description=One isolated proofpair arm (replace @ARM@ before installing)

[Service]
Type=exec
User=proofpair
Group=proofpair
WorkingDirectory=/srv/proofpair/base
Environment=HOME=/var/lib/proofpair
ExecStart=/opt/proofpair/bin/proofpair -arm @ARM@
StandardInput=null
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=0
Restart=no
RuntimeMaxSec=2h
RuntimeRandomizedExtraSec=0
TimeoutStopSec=10s
TimeoutStopFailureMode=kill
KillMode=control-group
SendSIGKILL=yes
Delegate=no
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectControlGroups=yes
ProtectSystem=strict
InaccessiblePaths=-/run/user
ReadWritePaths=/srv/proofpair/base /var/lib/proofpair
ReadOnlyPaths=/srv/proofpair/base/.lake
UMask=0077
MemoryMax=48G
TasksMax=1024
LimitNOFILE=8192
